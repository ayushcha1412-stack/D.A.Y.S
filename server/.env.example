# Copy this file to .env and fill in your values
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/days_yoga
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=1d
ADMIN_EMAIL=admin@anyogainstitute.org
ADMIN_PASSWORD=YourStrongPassword123!
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ── UPI Payment ─────────────────────────────────────────
UPI_VPA=yourname@upi
UPI_NAME=YOUR BUSINESS NAME
PAYMENT_TTL_SECONDS=60
